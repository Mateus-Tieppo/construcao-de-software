# Copie para .env (fora do Git) e troque os valores. Nenhum segredo real deve ser versionado (RNF23).
POSTGRES_PASSWORD=troque-esta-senha-admin
APP_DB_PASSWORD=troque-esta-senha-app
KEYCLOAK_ADMIN_PASSWORD=troque-esta-senha-keycloak
# senha dos usuários de demonstração do realm (cliente, organizador, operador, admin)
PULSEPASS_DEMO_PASSWORD=troque-esta-senha-demo
GRAFANA_ADMIN_PASSWORD=troque-esta-senha-grafana
# Chaves Ed25519 do QR (Base64). Vazias = par efêmero gerado na subida (apenas desenvolvimento).
QR_CHAVE_PRIVADA=
QR_CHAVE_PUBLICA=
